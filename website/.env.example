# Public website URLs. These are safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_VMS_APP_URL=https://app.yourdomain.com/login

# Server-side Sanity configuration. Do not prefix the token with NEXT_PUBLIC_.
SANITY_PROJECT_ID=g9jd8vpn
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-12
# Required when the production dataset is private; safe to leave blank only for
# a public dataset. Create a Sanity token with Viewer permissions.
SANITY_API_READ_TOKEN=
